#!/bin/sh
# Keep graphify-out/ out of code commits. The post-commit hook refreshes the
# graph and commits it separately, so a code commit must not carry graph
# changes (e.g. stale ones from a manual `make update-harness` swept in by
# `git add -A`). If graphify-out/ is staged together with other paths, unstage
# it - post-commit will pick it up. A commit of graphify-out/ alone is allowed.

staged=$(git diff --cached --name-only -- graphify-out/)
[ -n "$staged" ] || exit 0

other=$(git diff --cached --name-only -- . ':!graphify-out')
if [ -n "$other" ]; then
    git restore --staged graphify-out/
    echo "[pre-commit] graphify-out/ unstaged - post-commit will commit it separately"
fi

exit 0
