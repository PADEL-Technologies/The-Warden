# Salin ke .env, isi nilainya. `make docker-run` membaca file ini.
# .env sendiri tidak boleh masuk git — lihat .gitignore.

# --- wajib ---
DISCORD_TOKEN=ganti-dengan-token-bot
DATABASE_URL=postgres://warden:warden@localhost:5432/warden

# --- fitur ---
ONBOARDING_ENABLED=true
REGISTRATION_ENABLED=true
MODERATION_ENABLED=true

# --- registration: wajib saat REGISTRATION_ENABLED=true ---
REGISTRATION_LOCKET_CHANNEL_ID=000000000000000000
REGISTRATION_REPORT_CHANNEL_ID=000000000000000000
REGISTRATION_VERIFIER_ROLE_ID=000000000000000000
REGISTRATION_MAHASISWA_ROLE_ID=000000000000000000
REGISTRATION_ALUMNI_ROLE_ID=000000000000000000
REGISTRATION_PRODI_ROLES=d3-ti:000000000000000000,d3-tk:000000000000000000

# --- moderation: wajib saat MODERATION_ENABLED=true ---
# Role yang boleh menjalankan /keyword, /regex, /label — sekaligus role yang
# pesannya tidak ikut diperiksa filter.
MODERATION_ADMIN_ROLE_IDS=000000000000000000,000000000000000000

# --- moderation: opsional ---
# Channel yang isinya tidak diperiksa sama sekali. Kosongkan = semua diperiksa.
MODERATION_IGNORED_CHANNEL_IDS=
# Detik sebelum pesan peringatan menghapus dirinya sendiri.
MODERATION_WARNING_DELETE_AFTER=15

# --- logging ---
# DEBUG membuka PII (nama, NIM, prodi, linkedin, alasan tolak) ke stdout.
# Pakai sementara saat investigasi, jangan jadi setelan tetap.
LOG_LEVEL=INFO
